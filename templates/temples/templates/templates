<!DOCTYPE html><html><head><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Sports Predictor</title>
<style>body{background:#0b0f1a;color:#fff;font-family:Arial;padding:15px}.card{background:#151a27;border-radius:14px;padding:18px;margin:12px 0}.bar{height:12px;background:#222;border-radius:10px;display:flex;overflow:hidden}.b1{background:#3b82f6}.b2{background:#6b7280}.b3{background:#ef4444}input{width:70px;padding:10px;border-radius:8px;border:0;background:#1e2636;color:#fff;margin:4px}button{width:100%;padding:14px;background:#3b82f6;border:0;border-radius:10px;color:#fff;font-weight:bold;font-size:16px}</style>
</head><body>
<h1>⚽ Football Predictor</h1>
<div class="card" id="resultBox" style="display:none">
<h2 id="pred" style="text-align:center"></h2>
<div class="bar"><div id="bh" class="b1"></div><div id="bd" class="b2"></div><div id="ba" class="b3"></div></div>
<p>Home <span id="ph"></span>% | Draw <span id="pd"></span>% | Away <span id="pa"></span>%</p>
<p>Confidence: <b id="conf"></b>%</p>
</div>
<div class="card">
Home Goals <input id="hg" value="1.8" type="number" step="0.1"> Away Goals <input id="ag" value="1.1" type="number" step="0.1"><br>
Home Shots <input id="hs" value="14" type="number"> Away Shots <input id="as" value="9" type="number"><br>
Home SOT <input id="hst" value="5" type="number"> Away SOT <input id="ast" value="3" type="number"><br><br>
<button onclick="go()">PREDICT ANY MATCH</button>
</div>
<script>
async function go(){
 let d={home_goals:+hg.value,away_goals:+ag.value,home_shots:+hs.value,away_shots:+as.value,home_sot:+hst.value,away_sot:+ast.value};
 let r=await fetch('/predict',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)}); let j=await r.json();
 resultBox.style.display='block'; pred.innerText=j.prediction; conf.innerText=j.confidence; ph.innerText=j.probabilities.home; pd.innerText=j.probabilities.draw; pa.innerText=j.probabilities.away;
 bh.style.width=j.probabilities.home+'%'; bd.style.width=j.probabilities.draw+'%'; ba.style.width=j.probabilities.away+'%';
 window.scrollTo(0,0);
}
</script></body></html>
